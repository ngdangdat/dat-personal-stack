# PostgreSQL credentials used by the database service and app connections
POSTGRES_DB=engineering_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-secret-pass

# Node Agent Configuration
# Port on which the Node Agent daemon will listen (default: 8081)
PORT=8081

# Secret authorization token used for authentication handshake between the Frontend client (WebSockets) and the Node Agent daemon
# In production, replace this with a secure random string.
AGENT_SECRET_TOKEN=your-agent-secret-token

# Database URL for the backend server — when running via docker-compose, use the Docker service name "db" as host.
# For local (non-Docker) dev, change host to localhost and port to 45432.
DATABASE_URL=postgres://postgres:postgres-secret-pass@db:5432/engineering_assistant?sslmode=disable

# 32-byte (256-bit) encryption key for credentials stored in the DB (must be exactly 32 bytes)
# In production, replace this with a secure random 32-byte key.
ENCRYPTION_KEY=default-32-byte-encryption-key!!

