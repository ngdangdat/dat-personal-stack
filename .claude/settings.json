{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Write(**/.env)",
      "Read(**/.env.local)",
      "Write(**/.env.local)",
      "Read(**/.env.*.local)",
      "Write(**/.env.*.local)",
      "Read(**/.env.development)",
      "Write(**/.env.development)",
      "Read(**/.env.production)",
      "Write(**/.env.production)"
    ]
  }
}
